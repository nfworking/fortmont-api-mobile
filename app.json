{
  "expo": {
    "name": "Fortmont API Mobile ",
    "slug": "fortmont-api-mobile",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-web-browser"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
      "scheme": "com.fortmontapi.app",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.fortmontapi.app",
      "useCleartextTraffic": true
    },
    "extra": {
      "eas": {
        "projectId": "17f834c2-e741-4c08-ae43-ad98cf7db728"
      },
        "entraClientId": "827b9380-f015-42a7-a3fe-f8edc047001e",
        "entraTenantId": "d17e117c-a505-44bf-a8ad-ea1cb324d14a",
        "entraScopes": [
          "openid",
          "profile",
          "email",
          "User.Read"
        ]
    },
    "owner": "nfworking"
  }
}
