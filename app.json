{
  "expo": {
    "name": "Fortmont",
    "slug": "fortmont-api-mobile",
    "version": "1.9.5",

    "orientation": "portrait",
    "icon": "./assets/fortmont_icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "com.fortmontapi.app",

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "experiments": {
      "tsconfigPaths": true
    },

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },

    "assetBundlePatterns": [
      "**/*"
    ],

    "android": {
      "package": "com.fortmontapi.app",
      "googleServicesFile": "./google-services.json",
      "useCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/fortmont_icon.png",
        "backgroundColor": "#000000"
      }
    },

    "ios": {
      "bundleIdentifier": "com.fortmontapi.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true
    },

    "plugins": [
      "expo-web-browser",

      "@react-native-firebase/app",
      "@react-native-firebase/messaging",

      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBMessaging"
            ]
          }
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "17f834c2-e741-4c08-ae43-ad98cf7db728"
      },

      "fortmontIssuer": "https://api.fortmont.me",
      "fortmontClientId": "f8aeadf8-761f-4a50-a1e3-9ace4353e89c"
    },

    "owner": "nfworking"
  }
}